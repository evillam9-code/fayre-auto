rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function acceso() {
      return get(/databases/$(database)/documents/fayre_acceso/$(request.auth.uid)).data;
    }
    function activo() {
      return request.auth != null
        && exists(/databases/$(database)/documents/fayre_acceso/$(request.auth.uid))
        && acceso().activo == true;
    }
    function esAdmin() {
      return activo() && acceso().role == 'admin';
    }

    // Datos del sistema: solo usuarios con sesión y activos
    match /fayre/{docId} {
      allow read: if activo();
      allow create, update: if (docId == 'users')
          ? (esAdmin() && !request.resource.data.valor.matches('.*"password".*'))
          : ((docId == 'system_version') ? esAdmin() : activo());
      allow delete: if esAdmin();
    }

    // Permisos de cada cuenta: solo el admin los cambia
    match /fayre_acceso/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || esAdmin());
      allow write: if esAdmin();
    }

    // Usuario -> correo interno (necesario antes de iniciar sesión)
    match /fayre_login/{key} {
      allow get: if true;
      allow list: if false;
      allow write: if esAdmin();
    }

    // Preferencias personales
    match /fayre_prefs/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
